OPENAI_API_KEY=sk-...
# STT rotation (optional). Tried round-robin before local/OpenAI.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SPEECHMATICS_API_KEY=
GLADIA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=
SONIOX_API_KEY=
# Local faster-whisper only when in-process active jobs < this.
STT_LOCAL_MAX_ACTIVE_JOBS=2
API_KEY=change-me-admin
DATABASE_URL=postgresql://reciapp:password@your-vps-host:5432/reciapp
# Optional. Rate-limit counters in Redis. Empty = in-process memory.
REDIS_URL=
AUTH_JWT_SECRET=change-me-long-random-secret
AUTH_JWT_ISSUER=reciapp-api
AUTH_JWT_AUDIENCE=reciapp-ios
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=5184000
READINESS_TIMEOUT_SECONDS=3
MAINTENANCE_MODE=false
ENVIRONMENT=production
MAX_DURATION_SECONDS=600
SUPERWALL_WEBHOOK_SECRET=whsec_...
SUPERWALL_APPLICATION_ID=54783
PUBLIC_API_BASE_URL=https://51-255-43-100.sslip.io
COVER_PUBLIC_BASE_URL=
COVER_STORAGE_DIR=/tmp/reciapp-covers
APPLE_BUNDLE_ID=com.membri.reciapp
APPLE_ENVIRONMENT=Production
APPLE_ROOT_CA_PEM=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS8 .p8 contents. Use \n for newlines if the env file is a single line.
APPLE_PRIVATE_KEY=
# Optional. Empty derives the Apple refresh-token key from AUTH_JWT_SECRET.
APPLE_TOKEN_ENCRYPTION_KEY=
RATE_LIMIT_PER_IP_PER_MINUTE=90
RATE_LIMIT_PER_USER_PER_MINUTE=60
RATE_LIMIT_EXTRACT_PER_IP_PER_MINUTE=7
RATE_LIMIT_EXTRACT_PER_USER_PER_MINUTE=5
RATE_LIMIT_EXTRACT_DAILY_PER_USER=50
# Temporary load test only: fake miss path, zero OpenAI/yt-dlp. /ready shows extract_dry_run.
EXTRACT_DRY_RUN=false
EXTRACT_DRY_RUN_MODE=media
EXTRACT_DRY_RUN_HOLD_MS=500
EXTRACT_DRY_RUN_MEDIA_FILE=/tmp/reciapp-stress-sample.mp4
EXTRACT_DRY_RUN_MEDIA_URL=
EXTRACT_DRY_RUN_MEDIA_FRAMES=8
# Captions/subs this long skip audio+local Whisper (vision only if still incomplete).
CAPTION_SKIP_AUDIO_MIN_CHARS=80
FIRST_VISION_PASS_FRAMES=2
MAX_VISION_FRAMES=8
MAX_CONCURRENT_JOBS=8
# Worker: true only when reciapp-worker container is running (see docker-compose.worker.yml).
WORKER_ENABLED=false
WORKER_POLL_SECONDS=5
WORKER_LEASE_SECONDS=900
# Isolated stress stack only (docker-compose.stress.yml). Never on production.
STRESS_TEST_MODE=false
STRESS_RUN_ID=
STRESS_TOKEN=
STRESS_ALLOWED_HOSTS=stress-test.local
STRESS_MOCK_LATENCY_MS=0
STRESS_MOCK_FAIL_PCT=0
DASHBOARD_PASSWORD=pick-a-long-random-password
DASHBOARD_SESSION_SECRET=another-long-random-secret
DASHBOARD_COOKIE_SECURE=true
# Only trust X-Forwarded-For when request.client.host is in this list/range.
TRUSTED_PROXY_IPS=

# Enable maintenance on EVERY writer (web and worker) before a backup/reset.
# Drain all in-flight jobs before proceeding; this does not cancel active paid requests.
# Deferred BackgroundTasks stay pending.
# Reconcile pending jobs/reservations through separately authorized local recovery before reopening imports.
