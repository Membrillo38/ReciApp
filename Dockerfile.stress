FROM python:3.12-slim

# Stress mock path: no ffmpeg fixture, no Whisper model preload.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY migrations ./migrations
COPY stress/api-entrypoint.sh /api-entrypoint.sh
RUN chmod +x /api-entrypoint.sh \
    && addgroup --system reciapp && adduser --system --ingroup reciapp reciapp \
    && chown -R reciapp:reciapp /app

USER reciapp

ENV PYTHONUNBUFFERED=1
ENV TRUSTED_PROXY_IPS=127.0.0.1
ENV HF_HOME=/tmp/hf
ENV HUGGINGFACE_HUB_CACHE=/tmp/hf

HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"

ENTRYPOINT ["/api-entrypoint.sh"]
