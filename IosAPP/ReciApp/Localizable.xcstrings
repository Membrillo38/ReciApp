    "Tap any step to focus it. Next advances and checks off the current step. Use Ingredients to keep the recipe close while you cook.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen beliebigen Schritt, um ihn zu fokussieren. Weiter geht zum nächsten Schritt und hakt den aktuellen ab. Verwende Zutaten, um das Rezept beim Kochen griffbereit zu halten."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any step to focus it. Next advances and checks off the current step. Use Ingredients to keep the recipe close while you cook."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier paso para enfocarlo. Siguiente avanza y marca el paso actual. Usa Ingredientes para tener la receta a mano mientras cocinas."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une étape pour la sélectionner. Suivant avance et valide l'étape actuelle. Utilisez Ingrédients pour garder la recette à portée de main pendant que vous cuisinez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un passaggio per metterlo a fuoco. Avanti passa al successivo e contrassegna quello corrente. Usa Ingredienti per tenere la ricetta a portata di mano mentre cucini."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em qualquer etapa para focá-la. Avançar passa para a próxima e marca a atual como concluída. Use Ingredientes para manter a receita por perto enquanto cozinha."
          }
        }
      }
    },
